FROM forgejo.clmnt.xyz/clmnt/podman:latest@sha256:e0b77e679196576e99003549f59ed7fd27712c9f03135629fcc589fa5072b350

RUN --mount=type=tmpfs,target=/var << 'EOF'
set -e -o nounset -o pipefail
set -x

dnf --assumeyes --setopt=install_weak_deps=False install \
    git-core \
    nodejs24 \


dnf --assumeyes --setopt=install_weak_deps=False install \
    buildah \
    skopeo \
    jq \


dnf clean all
EOF
