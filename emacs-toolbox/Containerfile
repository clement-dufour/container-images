FROM registry.fedoraproject.org/fedora-toolbox:44@sha256:13f69b390c39446bf67eb5c8e3d2a93fe61c1d8ca7cf3b6c2f2d8d133f1b6119

RUN --mount=type=tmpfs,target=/var << 'EOF'
set -e -o nounset -o pipefail
set -x

dnf config-manager disable \
    fedora-cisco-openh264 \


dnf --assumeyes install \
    adw-gtk3-theme \
    flatpak-xdg-utils \


dnf --assumeyes install \
    emacs-pgtk \
    ripgrep \
    fd-find \
    gdouros-symbola-fonts \


dnf --assumeyes install \
    cmake \
    go \
    gopls \
    hadolint \
    hunspell \
    hunspell-en-US \
    hunspell-fr \
    libtool \
    nodejs-bash-language-server \
    nodejs-npm \
    pandoc \
    shfmt \
    wl-clipboard \


dnf clean all

ln -sf /usr/bin/flatpak-xdg-open /usr/bin/xdg-open
EOF
